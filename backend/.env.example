# Copy to .env and adjust.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Local development: SQLite file in backend/ (no database server needed).
DATABASE_URL=sqlite:///control_tower_dev.db

# Production / MySQL: create the database, load database/schema_mysql.sql, then point here.
#   CREATE DATABASE control_tower CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   mysql -u ct_user -p control_tower < database/schema_mysql.sql
# DATABASE_URL=mysql+pymysql://ct_user:ct_password@localhost:3306/control_tower?charset=utf8mb4

# Optional: run the test suite against MySQL instead of in-memory SQLite.
# TEST_DATABASE_URL=mysql+pymysql://ct_user:ct_password@localhost:3306/control_tower_test?charset=utf8mb4

# Backups (`flask --app run backup`, schedule it daily). Put BACKUP_DIR on another disk.
# BACKUP_DIR=/var/backups/control-tower
# BACKUP_KEEP_DAYS=30
# BACKUP_REMIND_DAYS=7

# The address people open Control Tower at: used in links in emails, Teams messages and calendar feeds.
APP_BASE_URL=http://localhost:5050

# Notifications by email (Phase 10). Leave MAIL_SERVER empty for in-app notifications only.
# Schedule `flask --app run notify --deliver` every minute and `flask --app run notify --checks` daily.
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=control-tower@example.com
# MAIL_PASSWORD=
# MAIL_FROM=Control Tower <control-tower@example.com>
# NOTIFY_DUE_DAYS=3

# Sign in with Microsoft Entra ID (Phase 10). Register an app in Entra ID with the redirect address
# <APP_BASE_URL>/api/v1/auth/entra/callback; leave these empty to keep password sign-in only.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=https://control-tower.example.com/api/v1/auth/entra/callback
# ENTRA_ALLOW_PASSWORD=true

# First admin created by `flask --app run seed`
SEED_ADMIN_EMAIL=admin@controltower.local
SEED_ADMIN_PASSWORD=ChangeMe123!
